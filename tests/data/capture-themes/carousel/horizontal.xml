<!-- Fixture written for EmulationStation-RE (MIT): Recalbox format 4, own content.
     Main theme of a carousel set (11g): horizontal carousel, band y 252-468, logos 256x144,
     selected x 1.5, three per screen; information bar in magenta at the bottom. -->
<theme>
	<formatVersion>4</formatVersion>
	<feature supported="carousel">
		<view name="system">
			<carousel name="systemcarousel">
				<type>horizontal</type>
				<pos>0 0.35</pos>
				<size>1 0.3</size>
				<color>808080FF</color>
				<logoSize>0.2 0.2</logoSize>
				<logoScale>1.5</logoScale>
				<maxLogoCount>3</maxLogoCount>
			</carousel>
			<text name="systemInfo" pos="0 0.85" size="1 0.1" color="FF00FFFF"/>
		</view>
	</feature>
</theme>
