<!-- Fixture written for EmulationStation-RE (MIT): Recalbox format 4, own content.
     Main theme of the set (<set>/theme.xml), read for the menus only (docs/THEMES.md section 10,
     "Vue menu"). Probes: tests/smoke/capture-themes.sh, screens menu-icons, menu-section, menu-switch and keyboard. -->
<theme>
	<formatVersion>4</formatVersion>
	<view name="menu">
		<!-- frame tinted green; selector bar: green background removed (dst x (1 - 00FF00)), then
		     blue added; selected text red; separators yellow (11f2) -->
		<menuBackground name="menubg">
			<color>00FF00FF</color>
		</menuBackground>
		<menuText name="menutext">
			<separatorColor>FFFF00FF</separatorColor>
			<selectorColor>0000FFFF</selectorColor>
			<selectedColor>FF0000FF</selectedColor>
		</menuText>
		<menuSwitch name="menuswitch">
			<pathOn>${root}/art/cyan.png</pathOn>
			<pathOff>${root}/art/yellow.png</pathOff>
		</menuSwitch>
		<menuIcons name="menuicons">
			<iconUI>${root}/art/red.png</iconUI>
			<iconSound>${root}/art/green.png</iconSound>
		</menuIcons>
		<menuSection name="menusection">
			<color>FF00FFFF</color>
		</menuSection>
	</view>
	<!-- on-screen keyboard over the game list of the system "options" (basic view): keys gray,
	     selected key magenta (11f5) -->
	<view name="basic, detailed">
		<keyboard name="keyboard">
			<keyColor>808080FF</keyColor>
			<keySelectedColor>FF00FFFF</keySelectedColor>
		</keyboard>
	</view>
</theme>
