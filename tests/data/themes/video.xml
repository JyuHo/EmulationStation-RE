<theme>
	<formatVersion>3</formatVersion>
	<view name="detailed">
		<video name="md_video">
			<pos>0.25 0.4</pos>
			<maxSize>0.45 0.4</maxSize>
			<origin>0.5 0.5</origin>
			<default>./default.mp4</default>
			<delay>1.5</delay>
			<showSnapshotNoVideo>true</showSnapshotNoVideo>
			<showSnapshotDelay>true</showSnapshotDelay>
		</video>
	</view>
</theme>
